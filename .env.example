# ========================================================
# PLANTILLA DE VARIABLES DE ENTORNO — SAMAES FOOD
# Copia este archivo como '.env' en tu servidor y llena tus credenciales
# ========================================================

# Base de Datos PostgreSQL (NeonDB / Supabase / Local)
SPRING_DATASOURCE_URL=jdbc:postgresql://<HOST>/<DB_NAME>?sslmode=require
SPRING_DATASOURCE_USERNAME=<TU_USUARIO>
SPRING_DATASOURCE_PASSWORD=<TU_CONTRASEÑA>
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Seguridad JWT (Cadena secreta de al menos 256 bits)
JWT_SECRET=TuClaveSecretaUltraSeguraParaFirmarTokensJWT2026

# Cloudinary (Fotos)
VITE_CLOUDINARY_CLOUD_NAME=<TU_CLOUD_NAME>
VITE_CLOUDINARY_UPLOAD_PRESET=<TU_UPLOAD_PRESET>
